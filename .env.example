# API de Lumon
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# Storage de imágenes: SUPABASE o CLOUDINARY
VITE_STORAGE_PROVIDER=

# Si usan Supabase (solo la clave PUBLICABLE / anon, nunca la secreta ni service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_BUCKET=lumon-media

# Si usan Cloudinary (solo cloud name y preset unsigned, nunca el API secret)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
